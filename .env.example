# ====== ACCESO ======
# Contraseña con la que la dueña entra a la app (larga, 12+ caracteres)
ACCESS_PASSWORD=
# Texto largo y aleatorio para firmar la sesión (32+ caracteres)
SESSION_SECRET=
# Nombre con el que la IA la saluda
OWNER_NAME=

# ====== IA (API de Claude) ======
# Si se deja vacía, la app funciona en MODO DEMO (sin IA real)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
# Límite de mensajes por día (protege el gasto)
DAILY_MESSAGE_LIMIT=250

# ====== BASES DE DATOS (Aiven) ======
# Base NUEVA solo para la IA: chats, recuerdos y uso
DATABASE_URL_MEMORIA=
# Base envios_ayora con un usuario de SOLO LECTURA
DATABASE_URL_LECTURA=
# Opcional: certificado CA de Aiven (si no se pone, se usa SSL sin verificar)
DATABASE_CA_CERT=

# ====== OPCIONAL ======
BUSINESS_NAME=Fénix Recolección y Envíos
ASSISTANT_NAME=Fénix IA
BUSINESS_TZ=America/Tijuana
